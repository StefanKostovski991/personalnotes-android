<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed icon (Android 13+): one flat silhouette on transparency, so the system can tint it.

  Coordinates mirror the coloured foreground, including its centring and scale, so the themed
  icon has the same proportions. Filled with #FFFFFF because the launcher replaces the colour
  with the user's theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 36.77,23.15 h 33.97 a 5.66,5.66,0,0,1,5.66,5.66 v 39.63 a 5.66,5.66,0,0,1,-5.66,5.66 h -33.97 a 5.66,5.66,0,0,1,-5.66,-5.66 v -39.63 a 5.66,5.66,0,0,1,5.66,-5.66 z" />

    <!-- pencil shaft, crossing the page as in the coloured mark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44.13,55.58 L 54.64,62.05 L 86.99,29.7 L 76.48,23.23 Z" />

    <!-- pencil tip -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 24.48,84.78 L 28.92,75.88 L 54.64,62.05 L 44.13,55.58 Z" />
</vector>
